# Frontend environment variables (public)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_APP_NAME=your-app-name

# Server-side environment variables (NEVER expose to browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
MP_ACCESS_TOKEN=your-mercado-pago-access-token
MP_PUBLIC_KEY=your-mercado-pago-public-key
MP_WEBHOOK_SECRET=your-mercado-pago-webhook-secret
MP_CLIENT_ID=your-mercado-pago-client-id
MP_CLIENT_SECRET=your-mercado-pago-client-secret
MP_OAUTH_REDIRECT_URI=https://your-project-ref.supabase.co/functions/v1/marketplace-oauth-callback

# App
APP_BASE_URL=http://localhost:5174
NODE_ENV=development
